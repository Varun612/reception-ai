# ReceptionAI Monorepo Environment Configuration Template
# Copy this file to server/.env and adjust keys as needed.

DATABASE_URL="file:./dev.db"
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5180

JWT_SECRET=reception_ai_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Gemini API Key (optional for local mock/deterministic mode; required for live LLM mode)
GEMINI_API_KEY=

# Stripe Billing (Set STRIPE_MOCK_MODE=true for testing without live credentials)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK_MODE=true

# Notification services
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

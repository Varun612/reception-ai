# Database Configuration (SQLite default for zero-friction local run; switch to postgresql for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/reception_ai?schema=public"

# Server Port & Host
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5180

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, the built-in deterministic autonomous agent tool-calling engine is used for offline testing!
GEMINI_API_KEY=

# Stripe Billing
# When STRIPE_MOCK_MODE=true, realistic simulated checkouts and webhook simulations are processed.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MOCK_MODE=true

# Email & SMS Notifications
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890
